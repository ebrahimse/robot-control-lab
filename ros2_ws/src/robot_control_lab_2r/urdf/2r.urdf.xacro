<?xml version="1.0"?>
<!--
  Robot Control Lab - Didactic planar 2R manipulator

  Mathematical convention:
    - Motion plane: x-z
    - Joint axes: -y
    - q1 = q2 = 0: both links aligned with +x
    - Positive q rotates +x toward +z

  Forward kinematics:
    x = L1*cos(q1) + L2*cos(q1 + q2)
    z = L1*sin(q1) + L2*sin(q1 + q2)

  Dynamic parameters of the moving links:
    L1 = L2 = 1.0 m
    m1 = m2 = 1.0 kg
    rectangular cross-section = 0.08 m x 0.08 m
    centers of mass at Li/2
    joint damping d1 = d2 = 0.7 N*m*s/rad

  The damping is intentionally retained from the original RRBot demo
  so that an ideal frictionless analytical model will not exactly
  reproduce the simulated dynamics.
-->

<robot name="robot_control_lab_2r"
       xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== -->
  <!-- Geometric parameters  -->
  <!-- ===================== -->

  <xacro:property name="PI" value="3.141592653589793"/>

  <xacro:property name="L1" value="1.0"/>
  <xacro:property name="L2" value="1.0"/>

  <xacro:property name="link_width" value="0.08"/>

  <xacro:property name="base_height" value="0.15"/>
  <xacro:property name="base_width" value="0.20"/>

  <!-- ===================== -->
  <!-- Dynamic parameters    -->
  <!-- ===================== -->

  <xacro:property name="m1" value="1.0"/>
  <xacro:property name="m2" value="1.0"/>

  <xacro:property name="base_mass" value="5.0"/>

  <xacro:property name="damping1" value="0.7"/>
  <xacro:property name="damping2" value="0.7"/>

  <!-- ===================== -->
  <!-- Visual materials      -->
  <!-- ===================== -->

  <material name="base_gray">
    <color rgba="0.35 0.35 0.35 1.0"/>
  </material>

  <material name="link1_orange">
    <color rgba="1.0 0.42 0.04 1.0"/>
  </material>

  <material name="link2_blue">
    <color rgba="0.10 0.35 0.85 1.0"/>
  </material>

  <material name="joint_dark">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>


  <!-- ========================================================= -->
  <!-- World and fixed base                                      -->
  <!--                                                           -->
  <!-- base_link is located at the center of joint1.             -->
  <!-- The physical pedestal extends downward to the ground.     -->
  <!-- ========================================================= -->

  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">

    <visual>
      <origin xyz="0 0 ${-base_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_width} ${base_width} ${base_height}"/>
      </geometry>
      <material name="base_gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 ${-base_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_width} ${base_width} ${base_height}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 ${-base_height/2}" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <inertia
        ixx="${base_mass/12.0*(base_width*base_width + base_height*base_height)}"
        ixy="0.0"
        ixz="0.0"
        iyy="${base_mass/12.0*(base_width*base_width + base_height*base_height)}"
        iyz="0.0"
        izz="${base_mass/12.0*(base_width*base_width + base_width*base_width)}"/>
    </inertial>

  </link>


  <!-- ========================================================= -->
  <!-- Joint 1                                                   -->
  <!--                                                           -->
  <!-- q1 = 0 => link1 aligned with +x                           -->
  <!-- positive q1 rotates link1 from +x toward +z               -->
  <!-- ========================================================= -->

  <joint name="joint1" type="continuous">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <dynamics damping="${damping1}" friction="0.0"/>
  </joint>


  <!-- ========================================================= -->
  <!-- Link 1                                                    -->
  <!--                                                           -->
  <!-- Frame origin: joint1                                      -->
  <!-- Length: L1                                                -->
  <!-- Center of mass: [L1/2, 0, 0]                             -->
  <!-- ========================================================= -->

  <link name="link1">

    <visual name="link1_bar">
      <origin xyz="${L1/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${L1} ${link_width} ${link_width}"/>
      </geometry>
      <material name="link1_orange"/>
    </visual>

    <!-- Visual marker for joint1 -->
    <visual name="joint1_marker">
      <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.12"/>
      </geometry>
      <material name="joint_dark"/>
    </visual>

    <collision>
      <origin xyz="${L1/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${L1} ${link_width} ${link_width}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="${L1/2} 0 0" rpy="0 0 0"/>
      <mass value="${m1}"/>
      <inertia
        ixx="${m1/12.0*(link_width*link_width + link_width*link_width)}"
        ixy="0.0"
        ixz="0.0"
        iyy="${m1/12.0*(L1*L1 + link_width*link_width)}"
        iyz="0.0"
        izz="${m1/12.0*(L1*L1 + link_width*link_width)}"/>
    </inertial>

  </link>


  <!-- ========================================================= -->
  <!-- Joint 2                                                   -->
  <!--                                                           -->
  <!-- Located exactly L1 from joint1. No geometric offset.      -->
  <!-- q2 is relative to link1.                                  -->
  <!-- ========================================================= -->

  <joint name="joint2" type="continuous">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="${L1} 0 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <dynamics damping="${damping2}" friction="0.0"/>
  </joint>


  <!-- ========================================================= -->
  <!-- Link 2                                                    -->
  <!--                                                           -->
  <!-- Frame origin: joint2                                      -->
  <!-- Length: L2                                                -->
  <!-- Center of mass: [L2/2, 0, 0]                             -->
  <!-- ========================================================= -->

  <link name="link2">

    <visual name="link2_bar">
      <origin xyz="${L2/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${L2} ${link_width} ${link_width}"/>
      </geometry>
      <material name="link2_blue"/>
    </visual>

    <!-- Visual marker for joint2 -->
    <visual name="joint2_marker">
      <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.12"/>
      </geometry>
      <material name="joint_dark"/>
    </visual>

    <collision>
      <origin xyz="${L2/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${L2} ${link_width} ${link_width}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="${L2/2} 0 0" rpy="0 0 0"/>
      <mass value="${m2}"/>
      <inertia
        ixx="${m2/12.0*(link_width*link_width + link_width*link_width)}"
        ixy="0.0"
        ixz="0.0"
        iyy="${m2/12.0*(L2*L2 + link_width*link_width)}"
        iyz="0.0"
        izz="${m2/12.0*(L2*L2 + link_width*link_width)}"/>
    </inertial>

  </link>


  <!-- End-effector reference frame: no mass, no geometry -->
  <link name="ee_link"/>

  <joint name="link2_to_ee" type="fixed">
    <parent link="link2"/>
    <child link="ee_link"/>
    <origin xyz="${L2} 0 0" rpy="0 0 0"/>
  </joint>


  <!-- ===================== -->
  <!-- Gazebo appearance     -->
  <!-- ===================== -->

  <gazebo reference="base_link">
    <material>
      <diffuse>0.35 0.35 0.35 1</diffuse>
      <ambient>0.35 0.35 0.35 1</ambient>
    </material>
  </gazebo>

  <gazebo reference="link1">
    <material>
      <diffuse>1.0 0.42 0.04 1</diffuse>
      <ambient>1.0 0.42 0.04 1</ambient>
    </material>
  </gazebo>

  <gazebo reference="link2">
    <material>
      <diffuse>0.10 0.35 0.85 1</diffuse>
      <ambient>0.10 0.35 0.85 1</ambient>
    </material>
  </gazebo>


  <!-- ===================== -->
  <!-- ros2_control          -->
  <!-- ===================== -->

  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="joint1">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="joint2">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>


  <!-- Connect ros2_control to Gazebo -->
  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find robot_control_lab_2r)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
